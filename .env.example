# ─── Model ───
BASE_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# ─── Training ───
OUTPUT_DIR=outputs
ADAPTER_DIR=adapters
EPOCHS=3
BATCH_SIZE=2
GRAD_ACCUM=4
LR=2e-4
MAX_SEQ_LEN=1024
LORA_R=16
LORA_ALPHA=32

# ─── Storage (optional, for v2 S3 backing) ───
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=

# ─── Hugging Face (optional, for private models) ───
# HF_TOKEN=